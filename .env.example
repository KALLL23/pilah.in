# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_TIMEZONE=Asia/Jakarta

# Database (will be used once the PostGIS stack is introduced)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=pilahin
DATABASE_USER=pilahin
DATABASE_PASSWORD=pilahin-local-only
DATABASE_PORT_FORWARD=5432

# Authentication
# Minimum 32 characters. Generate a unique random value for every installation.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# Initial admin account
# Both values must be set together. Bootstrap never creates duplicate admins.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Object storage (MinIO)
MINIO_ENDPOINT=minio:9000
# Set ke IP LAN laptop agar presigned image URL dapat dibuka dari HP.
MINIO_PUBLIC_ENDPOINT=192.168.1.10:9000
MINIO_ACCESS_KEY=pilahin-local
MINIO_SECRET_KEY=pilahin-local-secret
MINIO_BUCKET=pilahin
MINIO_SECURE=false
MINIO_PORT_FORWARD=9000
MINIO_CONSOLE_PORT_FORWARD=9001

# AI models
CLASSIFICATION_MODEL=/models/waste_cls.pt
CLASSIFICATION_MODEL_VERSION=PILAH-CLS-v0.1.0
CLASSIFICATION_IMAGE_SIZE=224
DETECTION_MODEL=/models/waste_det.pt
MODEL_CONFIDENCE_THRESHOLD=0.70
MAX_IMAGE_BYTES=8388608
PRESIGNED_URL_EXPIRY_SECONDS=900

# External services
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=pilah.in
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_PROMPT_VERSION=v1
